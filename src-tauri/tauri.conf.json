{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fjord",
  "version": "0.2.9",
  "identifier": "no.tjernsmo.fjord",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Fjord",
        "width": 1320,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local project management",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jhtjernsmo/fjord/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NEVEMDY0NTdFMzU1MjEKUldRaFZlTlhaTkJPNS9IZGlMMXJMb1c1RWdmaWltdjcxYlhCaVNwb29ZWUdyYm81N1lqRzJVSVoK"
    }
  }
}
